IO_LOC  "O_reconfig_n" 73;
IO_PORT "O_reconfig_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// FPGA-Companion (BL616 da placa): teclado USB
IO_LOC  "I_spi_csn" 86;
IO_PORT "I_spi_csn" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "I_spi_sclk" 13;
IO_PORT "I_spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "I_spi_mosi" 76;
IO_PORT "I_spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "O_spi_miso" 75;
IO_PORT "O_spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "O_spi_irqn" 69;
IO_PORT "O_spi_irqn" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// 2026-10-22: ESP32-S3 (SPI octal), resistencias de 100 ohm em serie na placa
