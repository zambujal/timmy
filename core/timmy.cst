// Tang Nano 20K - Timmy 2048div (formato da Gowin EDA)
// A SDRAM de dentro (O_sdram_*, IO_sdram_dq) nao leva pinos: a Gowin liga-a sozinha.
IO_LOC  "I_clk" 4;
IO_PORT "I_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "O_tmds_clk_p" 33,34;
IO_PORT "O_tmds_clk_p" PULL_MODE=NONE DRIVE=3.5;
IO_LOC  "O_tmds_data_p[0]" 35,36;
IO_PORT "O_tmds_data_p[0]" PULL_MODE=NONE DRIVE=3.5;
IO_LOC  "O_tmds_data_p[1]" 37,38;
IO_PORT "O_tmds_data_p[1]" PULL_MODE=NONE DRIVE=3.5;
IO_LOC  "O_tmds_data_p[2]" 39,40;
IO_PORT "O_tmds_data_p[2]" PULL_MODE=NONE DRIVE=3.5;

IO_LOC  "O_led[0]" 15;
IO_PORT "O_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led[1]" 16;
IO_PORT "O_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led3" 17;
IO_PORT "O_led3" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC  "I_reset" 88;
IO_PORT "I_reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "I_nmi" 87;
IO_PORT "I_nmi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "O_sd_clk" 83;
IO_PORT "O_sd_clk" IO_TYPE=LVCMOS33;
IO_LOC  "O_sd_mosi" 82;
IO_PORT "O_sd_mosi" IO_TYPE=LVCMOS33;
IO_LOC  "I_sd_miso" 84;
IO_PORT "I_sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "O_sd_cs_n" 81;
IO_PORT "O_sd_cs_n" IO_TYPE=LVCMOS33;
IO_LOC  "O_sd_dat1" 85;
IO_PORT "O_sd_dat1" IO_TYPE=LVCMOS33;
IO_LOC  "O_sd_dat2" 80;
IO_PORT "O_sd_dat2" IO_TYPE=LVCMOS33;
IO_LOC  "O_led_ofs[0]" 18;
IO_PORT "O_led_ofs[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "O_led_ofs[1]" 19;
